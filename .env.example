# ProxyAPI ключ (один ключ для OpenAI и Anthropic)
OPENAI_API_KEY=your_proxyapi_key_here
ANTHROPIC_API_KEY=your_proxyapi_key_here

# OpenAI Chat Completions (обычный режим)
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Messages API (думающий режим)
ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
THINKING_BUDGET_TOKENS=1500

# Общие настройки
REQUEST_TIMEOUT=60
SYSTEM_PROMPT=Вы полезный ассистент, отвечайте на русском языке.